# Operating systems and editors
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.code-workspace

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.pytest-tmp*/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/

# Secrets and local configuration
.env
.env.*
!.env.example
!.env.docker.example
**/secrets.h
**/secrets.ini

# Runtime databases and data
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
backend/data/*
!backend/data/.gitkeep
tools/audio-lab/data/*
!tools/audio-lab/data/.gitkeep

# Audio and measurement material
*.wav
*.mp3
*.flac
*.ogg
*.m4a
*.aac
*.csv
*.zip

# Models, exports, logs and caches
models/*
!models/.gitkeep
exports/*
!exports/.gitkeep
logs/*
!logs/.gitkeep
cache/
backups/
*.log

# Build artifacts
build/
dist/
*.egg-info/
firmware/**/.pio/
firmware/**/.vscode/

# Temporary files
/tmp/
/output/pdf/*.pdf
*.tmp
*.temp
*.bak
~$*
/.pytest-*/
/.artifact-*/

# KiCad local editor state. The Rev-A .kicad_pcb file itself is source.
*.kicad_prl
hardware/pcb/rev_a/*.kicad_pro
hardware/pcb/**/generated/

# Keep credential templates
!**/secrets.example.h
